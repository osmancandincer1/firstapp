# Nokuzo — environment variables (APP.md §20).
# Copy to .env.local (never commit real values). Every service below is
# NEEDS_SETUP until the owner creates the account; see docs/SETUP.md.
# Leave a value empty to keep the feature that needs it switched off.

# local | staging | production — each has its own database, bucket, keys and store products.
APP_ENV=local

# ---------------------------------------------------------------------------
# Public values (bundled into the mobile app). Only EXPO_PUBLIC_* reach the client.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Server-side only (Edge Functions, admin server, CI). Never in client code.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Secret key for HMAC of emails, phones and other identifiers (§13.7). Generate 32+ random bytes.
HASH_HMAC_SECRET=

# Liveness / face matching / image moderation (Phase 1–2). TODO(owner): AWS account.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
REKOGNITION_COLLECTION_ID=

# SMS OTP + number type lookup (Phase 1). TODO(owner): choose provider.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Transactional email (Phase 1). TODO(owner): Resend or Postmark.
EMAIL_API_KEY=
EMAIL_FROM=

# Subscriptions (Phase 8). TODO(owner): RevenueCat project.
REVENUECAT_IOS_KEY=
REVENUECAT_ANDROID_KEY=
REVENUECAT_WEBHOOK_SECRET=

# Monitoring and analytics.
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=

# Text moderation (Phase 5).
MODERATION_API_KEY=

# Sign in with Apple / Google (Phase 1). TODO(owner): Apple Developer + Google Cloud.
APPLE_TEAM_ID=
APPLE_SERVICE_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Expo EAS (builds, OTA updates). TODO(owner): Expo account.
EXPO_PROJECT_ID=
