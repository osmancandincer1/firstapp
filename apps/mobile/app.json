{
  "expo": {
    "name": "Nokuzo",
    "slug": "nokuzo",
    "scheme": "nokuzo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0F1021",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nokuzo.app"
    },
    "android": {
      "package": "com.nokuzo.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F1021",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-localization",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğraflarını seçmen için fotoğraf arşivine erişiyoruz. Yalnızca seçtiğin fotoğraflar yüklenir.",
          "cameraPermission": "Profil fotoğrafı çekmen için kamerayı kullanıyoruz."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Ses kartını kaydetmen için mikrofonu kullanıyoruz. Kayıt yalnızca sen başlattığında yapılır."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sana yakın kişileri göstermek için yaklaşık konumunu kullanıyoruz. Konumun yaklaşık 1 km'ye yuvarlanır ve kimseye gösterilmez."
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
