# Local Edge Function settings. Copy to supabase/functions/.env (git-ignored);
# `supabase start` / `supabase functions serve` load it automatically.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# by the local stack and must not be set here.

APP_ENV=local
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HASH_HMAC_SECRET=

# Development stand-ins (refused unless APP_ENV=local):
#   log  -> codes are printed in the function log instead of being sent
#   mock -> liveness always passes; the app shows a DEVELOPMENT card
EMAIL_PROVIDER=log
SMS_PROVIDER=log
LIVENESS_PROVIDER=mock

SUPPORT_EMAIL=destek@nokuzo.com
